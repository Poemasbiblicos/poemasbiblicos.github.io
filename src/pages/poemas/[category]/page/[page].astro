---
import { getCollection } from "astro:content";

import BaseLayout from "../../../../layouts/BaseLayout.astro";

const getCategorySlug = (category) =>
  category
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s+/g, "-");

const getCategoryPageUrl = (categorySlug, page) =>
  page === 1
    ? `/poemas/${categorySlug}/`
    : `/poemas/${categorySlug}/page/${page}/`;

export async function getStaticPaths() {
  const poemas = await getCollection("poemas");
  const poemsPerPage = 20;
  const getStaticCategorySlug = (category) =>
    category
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/\s+/g, "-");

  const categories = [
    ...new Set(
      poemas.map((poema) => poema.data.category)
    ),
  ];

  return categories.flatMap((category) => {
    const categoryPoemas = poemas.filter(
      (poema) =>
        poema.data.category === category
    );
    const totalPages = Math.ceil(categoryPoemas.length / poemsPerPage);

    return Array.from(
      { length: Math.max(totalPages - 1, 0) },
      (_, index) => {
        const currentPage = index + 2;
        const startIndex = (currentPage - 1) * poemsPerPage;

        return {
          params: {
            category: getStaticCategorySlug(category),
            page: String(currentPage),
          },

          props: {
            category,
            poemas: categoryPoemas.slice(
              startIndex,
              startIndex + poemsPerPage
            ),
            currentPage,
            totalPages,
          },
        };
      }
    );
  });
}

const { category, poemas, currentPage, totalPages } = Astro.props;
const categorySlug = getCategorySlug(category);
const paginationPages = Array.from(
  { length: totalPages },
  (_, index) => index + 1
);

const pageTitle = `${category} - Página ${currentPage} | Poemas Bíblicos`;

const pageDescription =
  `Explora ${category.toLowerCase()} llenos de fe, esperanza y reflexión cristiana. Página ${currentPage}.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>

  <section class="section">
    <div class="container">

      <div class="section-heading">
        <p class="section-kicker">
          Categoría
        </p>

        <h1 class="section-title">
          {category}
        </h1>

        <p class="section-description">
          {pageDescription}
        </p>
      </div>

        <div class="category-poems-list">

           {poemas.map((poema) => (
          <a
              href={`/poemas/${poema.id.split("/").pop()}/`}
           class="poem-preview-card"
            >
             <img
            src={poema.data.heroImage}
           alt={poema.data.title}
           loading="lazy"
             decoding="async"
            />

              <div class="poem-preview-content">

                <span class="poem-category-tag">
                {poema.data.category}
                </span>

                 <h2>
                    {poema.data.title}
                   </h2>

                     <p>
                       {poema.data.description}
                     </p>

               </div>
          </a>
          ))}

        </div>

        {totalPages > 1 && (
          <nav class="category-pagination" aria-label="Paginación de poemas">
            {currentPage > 1 ? (
              <a href={getCategoryPageUrl(categorySlug, currentPage - 1)}>
                Anterior
              </a>
            ) : (
              <span aria-disabled="true">
                Anterior
              </span>
            )}

            {paginationPages.map((page) => (
              page === currentPage ? (
                <span class="is-current" aria-current="page">
                  {page}
                </span>
              ) : (
                <a href={getCategoryPageUrl(categorySlug, page)}>
                  {page}
                </a>
              )
            ))}

            {currentPage < totalPages ? (
              <a href={getCategoryPageUrl(categorySlug, currentPage + 1)}>
                Siguiente
              </a>
            ) : (
              <span aria-disabled="true">
                Siguiente
              </span>
            )}
          </nav>
        )}

    </div>
  </section>

</BaseLayout>
