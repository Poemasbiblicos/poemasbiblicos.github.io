---
import { getCollection, render } from "astro:content";


import BaseLayout from "../../layouts/BaseLayout.astro";

const getPoemaUrl = (poema) => `/poemas/${poema.id.split("/").pop()}/`;

export async function getStaticPaths() {
  const poemas = await getCollection("poemas");
  const normalizeText = (value) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();

  const tokenize = (value) =>
    normalizeText(value)
      .split(/[^a-z0-9]+/)
      .filter((word) => word.length > 2);

  const countSharedWords = (sourceWords, targetWords) => {
    const targetSet = new Set(targetWords);

    return sourceWords.filter((word) => targetSet.has(word)).length;
  };

  const getRelatedPoemas = (currentPoema, allPoemas) => {
    const currentTags = tokenize(currentPoema.data.tags.join(" "));
    const currentCategoryWords = tokenize(currentPoema.data.category);
    const currentTextWords = tokenize(
      [
        currentPoema.data.title,
        currentPoema.data.description,
        currentPoema.data.category,
        currentPoema.data.tags.join(" "),
      ].join(" ")
    );

    return allPoemas
      .filter((candidate) => candidate.id !== currentPoema.id)
      .map((candidate) => {
        const candidateTags = tokenize(candidate.data.tags.join(" "));
        const candidateCategoryWords = tokenize(candidate.data.category);
        const candidateTextWords = tokenize(
          [
            candidate.data.title,
            candidate.data.description,
            candidate.data.category,
            candidate.data.tags.join(" "),
          ].join(" ")
        );

        const sameCategory =
          candidate.data.category === currentPoema.data.category;
        const sharedTags = countSharedWords(currentTags, candidateTags);
        const sharedCategoryWords = countSharedWords(
          currentCategoryWords,
          candidateCategoryWords
        );
        const sharedTextWords = countSharedWords(
          currentTextWords,
          candidateTextWords
        );

        return {
          poema: candidate,
          score:
            (sameCategory ? 1000 : 0) +
            sharedTags * 80 +
            sharedCategoryWords * 24 +
            sharedTextWords * 4 +
            (candidate.data.featured ? 2 : 0),
        };
      })
      .sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }

        const dateDiff =
          b.poema.data.pubDate.getTime() - a.poema.data.pubDate.getTime();

        if (dateDiff !== 0) {
          return dateDiff;
        }

        return a.poema.data.title.localeCompare(b.poema.data.title);
      })
      .slice(0, 6)
      .map(({ poema }) => poema);
  };

  return poemas.map((poema) => ({
    params: {
      slug: poema.id.split("/").pop(),
    },
    props: {
      poema,
      relatedPoemas: getRelatedPoemas(poema, poemas),
    },
  }));
}

const { poema, relatedPoemas } = Astro.props;

const { Content } = await render(poema);
const categorySlug = poema.data.category
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/\s+/g, "-");
---

<BaseLayout
  title={poema.data.title}
  description={poema.data.description}
  image={poema.data.heroImage}
  schemaType="Article"
>
  <article class="poema-page">
    <div class="poema-container">
        <nav class="poema-breadcrumb">

          <a href="/">
            Inicio
          </a>

          <span>›</span>

            <a href={`/poemas/${categorySlug}/`}>
             {poema.data.category}
            </a>

        </nav>
      <header class="poema-header">
        <span class="poema-category">
          {poema.data.category}
        </span>

        <img
          class="poema-image"
          src={poema.data.heroImage}
          alt={poema.data.title}
        />
      </header>

      <section class="poema-content">
        <Content />
      </section>

      <!-- En movil la imagen va despues del poema, para que el poema se vea al entrar -->
      <img
        class="poema-image poema-image-final"
        src={poema.data.heroImage}
        alt={poema.data.title}
        loading="lazy"
        decoding="async"
      />

      <aside class="compartir" aria-label="Compartir este poema">
        <p class="compartir-titulo">¿Te gustó? Compártelo con alguien especial</p>
        <div class="compartir-botones">
          <a class="compartir-btn compartir-whatsapp" data-share="whatsapp" href="#" rel="noopener" target="_blank">WhatsApp</a>
          <a class="compartir-btn compartir-facebook" data-share="facebook" href="#" rel="noopener" target="_blank">Facebook</a>
          <button class="compartir-btn compartir-copiar" type="button" data-share="copiar">Copiar enlace</button>
        </div>
      </aside>

      {relatedPoemas.length > 0 && (
        <section class="related-poemas" aria-labelledby="related-poemas-title">
          <div class="related-poemas-heading">
            <p class="related-poemas-kicker">
              Seguir leyendo
            </p>

            <h2 id="related-poemas-title">
              Poemas relacionados
            </h2>
          </div>

          <div class="related-poemas-grid">
            {relatedPoemas.map((relatedPoema) => (
              <a
                class="related-poema-card"
                href={getPoemaUrl(relatedPoema)}
              >
                <img
                  src={relatedPoema.data.heroImage}
                  alt={relatedPoema.data.title}
                  loading="lazy"
                  decoding="async"
                />

                <div class="related-poema-body">
                  <span>
                    {relatedPoema.data.category}
                  </span>

                  <h3>
                    {relatedPoema.data.title}
                  </h3>

                  <p>
                    {relatedPoema.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <script>
    const NL = "\n";
    const url = location.href.split("#")[0];
    const titulo = document.querySelector("h1")?.textContent?.trim() || document.title;
    const wa = (texto) => "https://wa.me/?text=" + encodeURIComponent(texto);

    // Barra general
    document.querySelectorAll("[data-share]").forEach((el) => {
      const tipo = el.getAttribute("data-share");
      if (tipo === "whatsapp") el.setAttribute("href", wa(titulo + NL + url));
      if (tipo === "facebook") el.setAttribute("href", "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(url));
      if (tipo === "copiar") el.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(url); el.textContent = "¡Enlace copiado!"; }
        catch { prompt("Copia el enlace:", url); }
      });
    });

    // Un boton bajo cada poema para enviar ese poema concreto
    document.querySelectorAll(".poema-cuadro").forEach((cuadro) => {
      let anterior = cuadro.previousElementSibling;
      let subtitulo = "";
      while (anterior && anterior.tagName !== "H2") {
        if (!subtitulo && anterior.querySelector("em")) subtitulo = anterior.textContent.trim();
        anterior = anterior.previousElementSibling;
      }
      const versos = [...cuadro.querySelectorAll("p")].map((p) => p.innerText.trim()).join(NL + NL);
      const texto = (subtitulo ? subtitulo + NL + NL : "") + versos + NL + NL + "Lee el poema completo: " + url;
      const a = document.createElement("a");
      a.className = "compartir-btn compartir-whatsapp compartir-poema";
      a.href = wa(texto);
      a.target = "_blank";
      a.rel = "noopener";
      a.textContent = "Enviar este poema por WhatsApp";
      cuadro.insertAdjacentElement("afterend", a);
    });
  </script>
</BaseLayout>
