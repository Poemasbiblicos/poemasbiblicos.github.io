---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { contenidoCategorias } from "../../data/categorias.js";

const getCategorySlug = (category) =>
  category
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s+/g, "-");

const getCategoryPageUrl = (categorySlug, page) =>
  page === 1
    ? `/poemas/${categorySlug}/`
    : `/poemas/${categorySlug}/page/${page}/`;

export async function getStaticPaths() {
  const poemas = await getCollection("poemas");
  const poemsPerPage = 20;
  const getStaticCategorySlug = (category) =>
    category
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/\s+/g, "-");

  const categories = [
    ...new Set(
      poemas.map((poema) => poema.data.category)
    ),
  ];

  return categories.map((category) => ({
    params: {
      category: getStaticCategorySlug(category)
    },

    props: {
      category,
      poemas: poemas.filter(
        (poema) =>
          poema.data.category === category
      ).slice(0, poemsPerPage),
      currentPage: 1,
      totalPages: Math.ceil(
        poemas.filter(
          (poema) =>
            poema.data.category === category
        ).length / poemsPerPage
      ),
    },
  }));
}

const { category, poemas, currentPage, totalPages } = Astro.props;
const categorySlug = getCategorySlug(category);
const paginationPages = Array.from(
  { length: totalPages },
  (_, index) => index + 1
);

const editorial = contenidoCategorias[categorySlug];

const pageTitle = editorial?.title ?? `${category} | Poemas Bíblicos`;

const pageDescription =
  editorial?.description ??
  `Explora ${category.toLowerCase()} llenos de fe, esperanza y reflexión cristiana.`;

const kicker = editorial?.kicker ?? "Categoría";

const intro =
  editorial?.intro ??
  `Explora ${category.toLowerCase()} llenos de fe, esperanza y reflexión cristiana.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>

  <section class="section">
    <div class="container">

      <div class="section-heading">
        <p class="section-kicker">
          {kicker}
        </p>

        <h1 class="section-title">
          {category}
        </h1>

        <p class="section-description">
          {intro}
        </p>
      </div>

        <div class="category-poems-list">

           {poemas.map((poema) => (
          <a
              href={`/poemas/${poema.id.split("/").pop()}/`}
           class="poem-preview-card"
            >
              <div class="poem-preview-content">

                <span class="poem-category-tag">
                {poema.data.category}
                </span>

                 <h2>
                    {poema.data.title}
                   </h2>

                     <p>
                       {poema.data.description}
                     </p>

               </div>
          </a>
          ))}

        </div>

        {totalPages > 1 && (
          <nav class="category-pagination" aria-label="Paginación de poemas">
            {currentPage > 1 ? (
              <a href={getCategoryPageUrl(categorySlug, currentPage - 1)}>
                Anterior
              </a>
            ) : (
              <span aria-disabled="true">
                Anterior
              </span>
            )}

            {paginationPages.map((page) => (
              page === currentPage ? (
                <span class="is-current" aria-current="page">
                  {page}
                </span>
              ) : (
                <a href={getCategoryPageUrl(categorySlug, page)}>
                  {page}
                </a>
              )
            ))}

            {currentPage < totalPages ? (
              <a href={getCategoryPageUrl(categorySlug, currentPage + 1)}>
                Siguiente
              </a>
            ) : (
              <span aria-disabled="true">
                Siguiente
              </span>
            )}
          </nav>
        )}

    </div>
  </section>

  {editorial?.secciones && (
    <section class="section pillar-intro">
      <div class="container">
        <div class="pillar-copy">
          {editorial.secciones.map((bloque) => (
            <Fragment>
              <h2>{bloque.titulo}</h2>
              {bloque.parrafos.map((parrafo) => (
                <p set:html={parrafo} />
              ))}
            </Fragment>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
