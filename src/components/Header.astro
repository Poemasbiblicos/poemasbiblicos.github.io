---
const navItems = [
  { label: 'Inicio', href: '/', active: true },

  {
    label: 'Poemas',
    dropdown: true,

    items: [
      {
        label: 'Ver todas las categorías',
        href: '/#categorias',
      },
      {
        label: 'Madres',
        href: '/poemas/poemas-para-la-madre/',
      },
      {
        label: 'English Poems for Mothers Day',
        href: '/poemas/biblical-poems-for-mothers-day/',
      },
      {
        label: 'Mujer',
        href: '/poemas/poemas-cristianos-para-la-mujer/',
      },

      {
        label: 'Esperanza',
        href: '/poemas/poemas-cristianos-de-esperanza/',
      },

      {
        label: 'Amor',
        href: '/poemas/poemas-biblicos-de-amor/',
      },

      {
        label: 'Reflexionar',
        href: '/poemas/poemas-cristianos-para-reflexionar/',
      },

      {
        label: 'Fe',
        href: '/poemas/poemas-cristianos-de-fe/',
      },

      {
        label: 'Fortaleza',
        href: '/poemas/poemas-cristianos-de-fortaleza/',
      },

      {
        label: 'Niños',
        href: '/poemas/poemas-para-ninos/',
      },

      {
        label: 'Jóvenes',
        href: '/poemas/poemas-cristianos-para-jovenes/',
      },

      {
        label: 'Adolescentes',
        href: '/poemas/poemas-cristianos-para-adolescentes/',
      },

    ],
  },

  { label: 'Destacados', href: '#destacados' },
  { label: 'Acerca de', href: '/acerca/' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Poemas Bíblicos, inicio">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 44" focusable="false">
          <path d="M7 8.5c8.8-4.4 17.2-4.2 25 0v29.8c-7.8-4.3-16.2-4.4-25-.2V8.5Z" />
          <path d="M57 8.5c-8.8-4.4-17.2-4.2-25 0v29.8c7.8-4.3 16.2-4.4 25-.2V8.5Z" />
          <path d="M32 8.5v29.8" />
        </svg>
      </span>
      <span class="brand-copy">
        <strong>Poemas Bíblicos</strong>
        <small>Palabras que inspiran tu alma</small>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navegación principal">

           {navItems.map((item) => (

             item.dropdown ? (

            <div class="nav-dropdown">

                  <button
                        class="nav-link nav-dropdown-button"
                        onclick="this.parentElement.classList.toggle('open')"
                        >
                        {item.label}
                  </button>

                  <div class="nav-dropdown-menu">

                   {item.items.map((subitem) => (

                      <a href={subitem.href}>
                     {subitem.label}
                     </a>

                    ))}

                  </div>

            </div>

          ) : (

            <a
              class:list={['nav-link', { 'is-active': item.active }]}
              href={item.href}
              >
               {item.label}
            </a>

            )

            ))}

  </nav>
  </div>
</header>
