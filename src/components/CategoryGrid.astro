---

<section
  class="section categories-section"
  id="categorias"
  aria-labelledby="categories-title"
>
  <div class="container">

    <div class="section-heading">
      <p class="section-kicker">
        Categorías principales
      </p>

      <h2
        class="section-title"
        id="categories-title"
      >
        Explora poemas cristianos por tema
      </h2>
    </div>

    <div class="category-grid">

      {categories.map((category) => {
        const icon = icons[category.icon];

        return (
          <a
            href={category.href}
            class:list={[
              'category-card',
              `tone-${category.tone}`,
              !category.available && 'disabled-card'
            ]}
          >
            <span class="category-count">
              {category.count}
            </span>

            <span
              class="category-icon"
              aria-hidden="true"
            >
              <svg
                viewBox={icon.viewBox}
                focusable="false"
              >
                {icon.paths.map((path: string) => (
                  <path d={path} />
                ))}
              </svg>
            </span>

            <h3>
              {category.title}
            </h3>

            <p>
              {category.description}
            </p>
          </a>
        );
      })}

    </div>

    <section
      class="category-seo-panel"
      aria-labelledby="category-seo-title"
    >
      <nav aria-label="Categorías de poemas cristianos y bíblicos">

        <h2 id="category-seo-title">
          Categorías de poemas cristianos y bíblicos
        </h2>

        <ul>
          {seoLinks.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>

      </nav>
    </section>

  </div>
</section>